FROM eclipse-temurin:25-jre

WORKDIR /deployments
COPY --chown=185:0 target/quarkus-app/lib/ lib/
COPY --chown=185:0 target/quarkus-app/*.jar ./
COPY --chown=185:0 target/quarkus-app/app/ app/
COPY --chown=185:0 target/quarkus-app/quarkus/ quarkus/

EXPOSE 8080
USER 185
ENTRYPOINT ["java", "--add-opens=java.base/java.lang=ALL-UNNAMED", "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar"]
